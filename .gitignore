__pycache__/
*.pyc

# Trained model weights — large, regenerated by research/03
models/*
models1/
!models/.gitkeep

# Jupyter autosave artifacts — NOT real content, safe to always ignore.
# (A stale checkpoint from this folder is what caused the duplicate-file
# situation this restructuring cleaned up — see README.md.)
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Raw/processed data — large, regenerated by research/01 and research/02.
# .gitkeep files are kept so the folder structure itself is still tracked.
data/raw/*
data/processed/*
data/splits/*
data/figures/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/splits/.gitkeep
!data/figures/.gitkeep

# Logs
logs/*.log

# Environment / secrets
.env
*.egg-info/
